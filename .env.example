# URL base da sua instância do ai-memory (sem a barra final).
# O servidor não sobe sem isso — não há instância padrão.
AI_MEMORY_URL=https://memory.example.com

# Token bearer da sua instância do ai-memory.
AI_MEMORY_AUTH_TOKEN=cole-aqui-o-seu-token

# Porta local da dash.
PORT=3838

# Interface de bind. Mantenha 127.0.0.1: a dash carrega o seu token e
# expõe rotas que editam e apagam memória, sem autenticação própria.
HOST=127.0.0.1
